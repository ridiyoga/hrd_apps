@section('js')
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.3/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script type="text/javascript">
    window.addEventListener("pageshow", function(event) {
        if (event.persisted) {
            // Reinitialize JS
            Swal.close();
        }
    });
    $(document).ready(function() {
        const dateContainer = $("#dateContainer")[0];
        const shiftList = $("#shiftList")[0];
        const weekLabel = $("#weekLabel")[0];
        let currentStart = new Date();
        currentStart.setDate(currentStart.getDate() - currentStart.getDay() + 1);

        let shiftData = {};

        function showSkeleton(selector) {
            const el = $(selector);

            el.html(
                `<span class="skeleton skeleton-number" style="width:100%"></span>`
            );
        }

        function hideSkeleton(selector, value) {
            $(selector)
                .html(value);
        }
        loadWeek();

        $("#prevWeek").on("click", () => changeWeek(-1));
        $("#nextWeek").on("click", () => changeWeek(1));

        function changeWeek(direction) {
            currentStart.setDate(currentStart.getDate() + (direction * 7));
            loadWeek();
        }

        function loadWeek() {
            const start = formatISO(currentStart);
            const end = formatISO(new Date(currentStart.getTime() + 6 * 86400000));

            console.log(start, end);

            weekLabel.innerText =
                `${formatLabel(currentStart)} - ${formatLabel(new Date(currentStart.getTime() + 6 * 86400000))}`;
            $('#start_date').val(start);
            // Swal.fire({
            //     allowOutsideClick: false,
            //     background: 'transparent',
            //     html: ' <div class="spinner-grow text-primary spinner-grow-sm me-2" role="status"></div><div class="spinner-grow text-primary spinner-grow-sm me-2" role="status"></div><div class="spinner-grow text-primary spinner-grow-sm me-2" role="status"></div>',
            //     showCancelButton: false,
            //     showConfirmButton: false,
            // });
            showSkeleton('#dateContainer');
            showSkeleton('#shiftList');
            $.getJSON(`/tukar_shift/get_TukarShiftData?start=${start}&end=${end}`)
                .done(function(data) {
                    shiftData = data;
                    hideSkeleton('#dateContainer', renderWeek());
                    hideSkeleton('#shiftList', renderWeek());
                })
                .fail(function() {
                    renderWeek();
                    Swal.close();
                    $('#alert_wrapper').stop(true, true).hide().html(
                        '<div class="alert alert-danger light alert-lg alert-dismissible fade show">' +
                        '<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="me-2"><polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"></polygon><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>' +
                        '<strong>Error!</strong>&nbsp;Error Memuat Laman Jadwal' +
                        '<button class="btn-close" data-bs-dismiss="alert" aria-label="btn-close"></button>'
                    ).fadeIn();
                    setTimeout(function() {
                        $('#alert_wrapper').fadeOut('slow');
                    }, 6000); // 3 detik
                });
        }

        function renderWeek() {
            dateContainer.innerHTML = "";
            const startDate = new Date(currentStart);
            let firstButton = null;

            for (let i = 0; i < 7; i++) {
                const date = new Date(startDate);
                date.setDate(startDate.getDate() + i);
                const dateStr = formatISO(date);

                const btn = document.createElement("button");
                btn.className = "btn btn-sm border text-center flex-shrink-0";
                btn.style.minWidth = "90px";
                btn.innerHTML =
                    `
            <small class="fw-semibold">${date.toLocaleDateString('id-ID', { weekday: 'short' })}</small>
            <small class="text-muted">&nbsp;${date.toLocaleDateString('id-ID', { day: '2-digit', month: 'short' })}</small>`;
                btn.dataset.date = dateStr;
                // btn.addEventListener("click", () => selectDate(btn));
                dateContainer.appendChild(btn);

                if (i === 0) firstButton = btn;
            }

            if (firstButton) selectDate(firstButton);
        }

        // function selectDate(btn) {
        //     $("#dateContainer button").removeClass("btn-primary text-white");
        //     btn.classList.add("btn-primary", "text-white");

        //     const date = btn.dataset.date;
        //     const shifts = shiftData[date] || [];
        //     // console.log(shifts);
        //     renderShifts(date, shifts);
        // }

        function getAllShifts() {
            let all = [];

            Object.keys(shiftData).forEach(date => {
                const shifts = shiftData[date] || [];

                shifts.forEach(s => {
                    all.push({
                        ...s,
                        tanggal: date // simpan tanggalnya
                    });
                });
            });

            return all;
        }

        function renderShifts(date, shifts) {
            let html = `<h6 class="mb-3 text-center">Shift tanggal ${formatLabel(date)}</h6>`;
            if (shifts.length === 0) {
                html += `<p class="text-center text-muted">Tidak ada jadwal shift di tanggal ini.</p>`;
            } else {
                console.log(shifts);
                html += '';
                shifts.forEach(s => {
                    if (s.status_approved == 1) {
                        var approved = '-history';
                    } else {
                        var approved = '';
                    }
                    html += `<a class="btn_editmapping" href="javascript:void(0)" data-id="${s.id_mapping}" 
                        data-karyawan="${s.name}" 
                        data-shift="${s.shift_id}" 
                        data-jam_shift="${s.jam_shift}"
                        data-status="${s.status_approved}"
                        data-pengajuan_signature="${s.pengajuan_signature}" 
                        data-approved_signature="${s.approved_signature}"
                        data-karyawan_input="${s.karyawan_input}"
                        data-karyawan_approved="${s.karyawan_approved}"
                        data-tanggal_input="${s.tanggal_input}"
                        data-tanggal_approved="${s.tanggal_approved}"
                        data-tanggal="${date}">
                        <div class="coworker-card${approved} d-flex align-items-center mb-3">
                                     <div class="avatar-wrapper">
                                  <i class="fa-solid fa-dot"></i>
                                        </div>
                                        {{-- INFO --}}
                                        <div class="flex-grow-1 ms-3 text-start">
                                            <h6 class="mb-1 fw-semibold">${s.name}</h6>

                                            <div class="text-muted small">
                                                Shift : ${s.shift}
                                                <span class="mx-1">•</span>
                                                ${s.jam_shift}
                                               

                                            </div>
                                        </div>
                                        {{-- ICON --}}
                                        <div class="icon-box${approved}">
                                        <i class="fa-solid fa-user"></i>
                                        </div>
                                    </div></a>`;

                });
            }
            shiftList.innerHTML = html;
        }

        function formatISO(date) {
            const d = new Date(date);
            return d.toISOString().split('T')[0];
        }

        function formatLabel(date) {
            const d = new Date(date);
            return d.toLocaleDateString('id-ID', {
                day: '2-digit',
                month: 'short'
            });
        }

        // let table = new DataTable('#table_mapping_shift');
        $(document).on('click', '.btnSelected', function() {
            const startDate = $('#start_date').val();
            const menu_active = '{{ $menu_active }}';

            window.location.href =
                "{{ url('mapping_shift/tambah_mapping') }}" + "/" + menu_active +
                "?start_date=" + startDate;
        });
        $(document).on('click', ".btn_editmapping", function() {
            Swal.fire({
                allowOutsideClick: false,
                background: 'transparent',
                html: ' <div class="spinner-grow text-primary spinner-grow-sm me-2" role="status"></div><div class="spinner-grow text-primary spinner-grow-sm me-2" role="status"></div><div class="spinner-grow text-primary spinner-grow-sm me-2" role="status"></div>',
                showCancelButton: false,
                showConfirmButton: false,

            });
            $('#btn_ubah_hapus').html('');
            $('#status_mapping').html('');
            var id_mapping = $(this).data('id');
            var karyawan = $(this).data('karyawan');
            var shift = $(this).data('shift');
            var jam_shift = $(this).data('jam_shift');
            var tanggal = $(this).data('tanggal');
            var pengajuan_signature = $(this).data('pengajuan_signature');
            var approved_signature = $(this).data('approved_signature');
            var karyawan_input = $(this).data('karyawan_input');
            var karyawan_approved = $(this).data('karyawan_approved');
            var tanggal_input = $(this).data('tanggal_input');
            var tanggal_approved = $(this).data('tanggal_approved');
            // console.log(tanggal_input, tanggal_approved);
            $('#ttd_hrd').empty();
            if (approved_signature == null) {
                $('.ttd_hrd').html(
                    '<i class="fa-solid fa-xmark"></i><small class="text-muted">Belum disetujui</small>'
                );
            } else {
                $('.ttd_hrd').html('<img class="img-fluid" src="/storage/signatures/' +
                    approved_signature + '" alt="Signature">');
            }
            var status = $(this).data('status');
            $('#id_mapping').val(id_mapping);
            $('#txt_karyawan').html(karyawan);
            $('#shift').val(shift);
            $('#tanggal').val(tanggal);
            if (status == 1) {
                $('#btn_ubah_hapus').html('');
                $('#hrd_name').html(karyawan_approved);
                $('#user_name').html(karyawan_input);
                $('#hrd_tgl').html(tanggal_approved);
                $('#user_tgl').html(tanggal_input);
                $('.ttd_user').stop(true, true).hide().html(
                    `${pengajuan_signature ? `<img src="/storage/signatures/${pengajuan_signature}" width="150" alt="Tanda Tangan">`:`<i class="fa-solid fa-clock-rotate-left text-muted"></i>`}`
                ).show();
                $('.ttd_hrd').stop(true, true).hide().html(
                    `${pengajuan_signature ? `<img src="/storage/signatures/${approved_signature}" width="150" alt="Tanda Tangan">`:`<i class="fa-solid fa-clock-rotate-left text-muted"></i>`}`
                ).show();
                $('#image_signature').attr('src', '/storage/signatures/' + pengajuan_signature);
            } else {
                $('.ttd_user').stop(true, true).hide().html(
                    `${pengajuan_signature ? `<img src="/storage/signatures/${pengajuan_signature}" width="150" alt="Tanda Tangan">`:`<i class="fa-solid fa-clock-rotate-left text-muted"></i>`}`
                ).show();
                $('.ttd_hrd').stop(true, true).hide().html(
                    `${approved_signature ? `<img src="/storage/signatures/${approved_signature}" width="150" alt="Tanda Tangan">`:`<i class="fa-solid fa-clock-rotate-left text-muted"></i>`}`
                ).show();
                $('#user_name').html(karyawan_input);
                $('#user_tgl').html(tanggal_input);
                $('#image_signature').attr('src', '/storage/signatures/' + pengajuan_signature);
                $('#btn_ubah_hapus').html(
                    '<button type="button" id="btnUpdateMappingShift" class="btn btn-sm light btn-success btn-sm px-1 me-2"><i class="fa fa-save me-1 mr-1"></i> Update</button><button type="button" class="btn_deletemapping btn light btn-danger btn-sm btn-sm px-1 ml-1"><i class="fa fa-times me-1"></i> Hapus</button>'
                );
            }
            $('#jam_shift').val(jam_shift);
            // console.log(id_mapping, karyawan, shift, jam_shift, tanggal);

            const offcanvasEl = document.getElementById('off-canvas-mapping_shift');
            const offcanvas = new bootstrap.Offcanvas(offcanvasEl);
            offcanvas.show();
            Swal.close();
        });
        $(document).on('click', '#btn_lihat_approved', function() {
            var signature = $(this).data('signature');
            // console.log('approved_signature', signature);
            const offcanvasEl = document.getElementById('off-canvas-mapping_shift');
            const offcanvasTandaTangan = document.getElementById('off-canvas-tanda_tangan');
            const offcanvas = new bootstrap.Offcanvas(offcanvasEl);
            const offcanvastandatangan = new bootstrap.Offcanvas(offcanvasTandaTangan);
            offcanvas.hide();
            offcanvastandatangan.show();
            $('#image_signature').attr('src', '/storage/signatures/' + signature);
            var karyawan = $(this).data('karyawan');
            var tanggal = $(this).data('tanggal');
            var jabatan = $(this).data('jabatan');
            $('#jabatan').html(jabatan);
            $('#nama_terang').html(karyawan + '<br>' + '(' + tanggal + ')');
        });
        $(document).on('click', '#btnUpdateMappingShift', function() {
            var id_mapping = $('#id_mapping').val();
            var shift = $('#shift').val();
            Swal.fire({
                title: 'Apakah anda yakin?',
                text: "Data akan diubah",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: 'var(--bs-primary)',
                cancelButtonColor: 'var(--bs-danger)',
                confirmButtonText: 'Ya, Ubah',
                cancelButtonText: 'Batal',

            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: "{{ url('mapping_shift/update_mapping_shift') }}",
                        type: 'POST',
                        data: {
                            '_token': '{{ csrf_token() }}',
                            'id_mapping': id_mapping,
                            'shift': shift,
                        },
                        beforeSend: function() {
                            Swal.fire({
                                allowOutsideClick: false,
                                background: 'transparent',
                                html: ' <div class="spinner-grow text-primary spinner-grow-sm me-2" role="status"></div><div class="spinner-grow text-primary spinner-grow-sm me-2" role="status"></div><div class="spinner-grow text-primary spinner-grow-sm me-2" role="status"></div>',
                                showCancelButton: false,
                                showConfirmButton: false,

                            });
                        },
                        success: function(response) {
                            // console.log(response);
                            Swal.close();
                            if (response.code == '500') {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Gagal',
                                    text: response.message,
                                });
                                $('#alert_wrapper').stop(true, true).hide().html(
                                    '<div class="alert alert-danger light alert-lg alert-dismissible fade show">' +
                                    '<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="me-2"><polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"></polygon><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>' +
                                    '<strong>Error!</strong>&nbsp;' + response
                                    .message +
                                    '<button class="btn-close" data-bs-dismiss="alert" aria-label="btn-close"></button>'
                                ).fadeIn();
                                setTimeout(function() {
                                    $('#alert_wrapper').fadeOut('slow');
                                }, 6000); // 3 detik
                            } else {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Berhasil',
                                    text: response.message,
                                });
                                $('#modal_edit_mapping_shift').modal('hide');
                                $('#alert_wrapper').stop(true, true).hide().html(
                                    '<div class="alert alert-success light alert-lg alert-dismissible fade show">' +
                                    '<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="me-2"><polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"></polygon><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>' +
                                    '<strong>Sukses!</strong>&nbsp;' + response
                                    .message +
                                    '<button class="btn-close" data-bs-dismiss="alert" aria-label="btn-close"></button>'
                                ).fadeIn();
                                setTimeout(function() {
                                    $('#alert_wrapper').fadeOut('slow');
                                }, 6000); // 3 detik
                            }
                            const el = document.getElementById(
                                'off-canvas-mapping_shift');
                            const offcanvas = bootstrap.Offcanvas
                                .getOrCreateInstance(el);
                            offcanvas.hide();
                            loadWeek();
                            // window.location.reload();
                        },
                        error: function(xhr, status, error) {
                            // console.log(xhr);
                            Swal.close();
                            Swal.fire({
                                icon: 'error',
                                title: 'Oops...',
                                text: xhr.responseJSON.message,
                            })
                        }
                    })
                } else {
                    Swal.close();
                    $('#modal_edit_mapping_shift').modal('hide');
                }
            })



        });
        $(document).on('click', '.btn_deletemapping', function() {
            // console.log('hapus mapping');
            var id_mapping = $('#id_mapping').val();
            Swal.fire({
                title: 'Apakah anda yakin?',
                text: "Data akan dihapus",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: 'var(--bs-primary)',
                cancelButtonColor: 'var(--bs-danger)',
                confirmButtonText: 'Ya, Hapus',
                cancelButtonText: 'Batal',

            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: "{{ url('mapping_shift/delete_mapping_shift') }}",
                        type: 'POST',
                        data: {
                            '_token': '{{ csrf_token() }}',
                            'id_mapping': id_mapping,
                        },
                        beforeSend: function() {
                            Swal.fire({
                                allowOutsideClick: false,
                                background: 'transparent',
                                html: ' <div class="spinner-grow text-primary spinner-grow-sm me-2" role="status"></div><div class="spinner-grow text-primary spinner-grow-sm me-2" role="status"></div><div class="spinner-grow text-primary spinner-grow-sm me-2" role="status"></div>',
                                showCancelButton: false,
                                showConfirmButton: false,

                            });
                        },
                        success: function(response) {
                            // console.log(response);
                            Swal.close();
                            if (response.code == 500) {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Gagal',
                                    text: response.message,
                                    timer: 5200,
                                });
                                $('#alert_wrapper').stop(true, true).hide().html(
                                    '<div class="alert alert-danger light alert-lg alert-dismissible fade show">' +
                                    '<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="me-2"><polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"></polygon><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>' +
                                    '<strong>Info!</strong>&nbsp;' + response
                                    .message +
                                    '<button class="btn-close" data-bs-dismiss="alert" aria-label="btn-close"></button>'
                                ).fadeIn();
                                setTimeout(function() {
                                    $('#alert_wrapper').fadeOut('slow');
                                }, 5000); // 3 detik
                            } else {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Berhasil',
                                    text: response.message,
                                    timer: 5200,
                                });
                                $('#alert_wrapper').stop(true, true).hide().html(
                                    '<div class="alert alert-success light alert-lg alert-dismissible fade show">' +
                                    '<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="me-2"><polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"></polygon><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>' +
                                    '<strong>Sukses</strong>&nbsp;' + response
                                    .message +
                                    '<button class="btn-close" data-bs-dismiss="alert" aria-label="btn-close"></button>'
                                ).fadeIn();
                                setTimeout(function() {
                                    $('#alert_wrapper').fadeOut('slow');
                                }, 5000); // 3 detik
                            }
                            const el = document.getElementById(
                                'off-canvas-mapping_shift');
                            const offcanvas = bootstrap.Offcanvas
                                .getOrCreateInstance(el);
                            offcanvas.hide();
                            loadWeek();

                            // window.location.reload();
                        },
                        error: function(xhr, status, error) {
                            // console.log(xhr);
                            Swal.close();
                            Swal.fire({
                                icon: 'error',
                                title: 'Oops...',
                                text: xhr.responseJSON.message,
                                timer: 5200,
                            })
                        }
                    })
                }
            })
        });
        $(document).on('click', '.btn-close-canvas-tanda_tangan', function() {
            const offcanvasEl = this.closest('.offcanvas');
            // console.log(offcanvasEl);
            if (!offcanvasEl) return;

            const offcanvas = bootstrap.Offcanvas.getInstance(offcanvasEl);
            if (offcanvas) {
                offcanvas.hide();
            }
        });
        $(document).on('click', '.btn-close-canvas-mapping_shift', function() {
            const offcanvasEl = this.closest('.offcanvas');

            if (!offcanvasEl) return;

            const offcanvas = bootstrap.Offcanvas.getInstance(offcanvasEl);
            if (offcanvas) {
                offcanvas.hide();
            }
        });
        window.onbeforeunload = function() {
            Swal.fire({
                allowOutsideClick: false,
                background: 'transparent',
                html: ' <div class="spinner-grow text-primary spinner-grow-sm me-2" role="status"></div><div class="spinner-grow text-primary spinner-grow-sm me-2" role="status"></div><div class="spinner-grow text-primary spinner-grow-sm me-2" role="status"></div>',
                showCancelButton: false,
                showConfirmButton: false,
                onBeforeOpen: () => {
                    // Swal.showLoading()
                },
            });
        };
    });
</script>
@endsection